---
import ChileFlag from './svg/ChileFlag.astro';

// Franja de respaldo institucional. Va justo debajo del bloque de equipo,
// que es donde el texto afirma la afiliación con la USM: los logos
// sustentan esa afirmación en el mismo punto donde se hace.
//
// Los logos usan las variantes para fondo oscuro (ver design/logos/README.md):
// el escudo UTFSM y el swoosh de FESW conservan sus colores oficiales, y solo
// el texto que venía en negro pasa a blanco. Así la franja vive sobre el mismo
// fondo que el resto de la página, sin introducir una superficie clara que
// termine siendo el punto más brillante de la sección.
---

<aside class="institutional" aria-labelledby="institutional-title">
  <div class="institutional-head" data-reveal>
    <p class="subeyebrow" id="institutional-title">Contexto académico</p>
    <p class="institutional-copy">
      BIOHI se desarrolla en el Departamento de Informática de la Universidad Técnica
      Federico Santa María y se presentará en la Feria de Software.
    </p>
  </div>

  <div class="institutional-card" data-reveal>
    <div class="logo-lockup">
      <img
        class="logo-utfsm"
        src="/logos/utfsm-informatica-oscuro.png"
        width="882"
        height="126"
        alt="Universidad Técnica Federico Santa María — Departamento de Informática"
        loading="lazy"
        decoding="async"
      />
      <img
        class="logo-fesw"
        src="/logos/fesw-usm-oscuro.png"
        width="272"
        height="138"
        alt="Feria de Software USM"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="institutional-place">
      <ChileFlag class="flag-cl" />
      <div>
        <strong>Santiago, Chile</strong>
        <small>Campus San Joaquín USM</small>
      </div>
    </div>
  </div>
</aside>
