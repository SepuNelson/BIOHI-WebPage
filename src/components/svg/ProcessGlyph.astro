---
// Glifos de las seis etapas del proceso. Cada uno dibuja lo que la etapa
// hace, no un icono decorativo: normalización son barras dispares que salen
// iguales, vigilancia es un barrido de radar con una señal detectada.
interface Props {
  step: 'datos' | 'integracion' | 'normalizacion' | 'analisis' | 'prediccion' | 'vigilancia';
  class?: string;
}

const { step, class: className = 'process-glyph' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false">
  {step === 'datos' && (
    <g>
      <circle cx="12" cy="12" r="8.6" />
      <circle cx="9.2" cy="9" r="1.7" fill="currentColor" stroke="none" />
      <circle cx="15.1" cy="11.3" r="2.4" fill="currentColor" stroke="none" />
      <circle cx="10.8" cy="15.7" r="1.2" fill="currentColor" stroke="none" />
    </g>
  )}

  {step === 'integracion' && (
    <g>
      <path d="M3 6c6 0 5.4 6 10.4 6" />
      <path d="M3 12h10.4" />
      <path d="M3 18c6 0 5.4-6 10.4-6" />
      <path d="M13.4 12H21" />
      <path d="M18.2 9.2 21 12l-2.8 2.8" />
    </g>
  )}

  {step === 'normalizacion' && (
    <g>
      <path d="M3 18.6h18" />
      <path d="M4.6 16.6v-4.4M7.8 16.6v-8.2M11 16.6v-2.6" />
      <path d="M15.4 16.6v-5.6M18.2 16.6v-5.6M21 16.6v-5.6" />
      <path d="M12.6 6.4h1.6" stroke-opacity=".45" />
    </g>
  )}

  {step === 'analisis' && (
    <g>
      <circle cx="10.4" cy="10.4" r="6.6" />
      <path d="M15.3 15.3 20.6 20.6" />
      <path d="M7.3 12.2 9.6 9.4l2 1.6 2.6-3.4" />
    </g>
  )}

  {step === 'prediccion' && (
    <g>
      <circle cx="5" cy="7.6" r="1.9" />
      <circle cx="5" cy="16.4" r="1.9" />
      <circle cx="12" cy="12" r="2.3" />
      <circle cx="19" cy="7" r="1.9" />
      <circle cx="19" cy="17" r="1.9" />
      <path d="M6.6 8.6 9.9 10.9M6.6 15.4 9.9 13.1M14.1 10.8 17.3 8.2M14.1 13.2 17.3 15.8" />
    </g>
  )}

  {step === 'vigilancia' && (
    <g>
      <circle cx="12" cy="12" r="8.6" />
      <circle cx="12" cy="12" r="4.6" stroke-dasharray="2 2.6" stroke-opacity=".55" />
      <path d="M12 12 18.3 6.6" />
      <circle cx="16.2" cy="8.9" r="1.7" fill="currentColor" stroke="none" />
    </g>
  )}
</svg>
