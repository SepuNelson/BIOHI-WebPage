---
// Bandera de Chile en proporción oficial 2:3.
// Cantón azul: 1/3 del ancho x 1/2 del alto (cuadrado). Estrella blanca de
// cinco puntas centrada en el cantón, radio exterior 88 sobre un lado de 300.
interface Props {
  class?: string;
  title?: string;
}

const { class: className = 'flag-cl', title = 'Bandera de Chile' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 900 600"
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg">
  <rect width="900" height="600" fill="#ffffff" />
  <rect y="300" width="900" height="300" fill="#d52b1e" />
  <rect width="300" height="300" fill="#0039a6" />
  <polygon
    fill="#ffffff"
    points="150.00,62.00 169.76,122.81 233.69,122.81 181.97,160.39 201.73,221.19 150.00,183.61 98.27,221.19 118.03,160.39 66.31,122.81 130.24,122.81"
  />
</svg>
