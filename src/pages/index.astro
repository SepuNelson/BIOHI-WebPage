---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgarField from '../components/svg/AgarField.astro';
import LogoAnimated from '../components/svg/LogoAnimated.astro';
import FragmentFlow from '../components/svg/FragmentFlow.astro';
import AntibiogramGrid from '../components/svg/AntibiogramGrid.astro';
import ProcessGlyph from '../components/svg/ProcessGlyph.astro';
import InstitutionalStrip from '../components/InstitutionalStrip.astro';
import ImpactGlyph from '../components/svg/ImpactGlyph.astro';
import IntelligenceGlyph from '../components/svg/IntelligenceGlyph.astro';
import ChileFlag from '../components/svg/ChileFlag.astro';

const title = 'BIOHI | Inteligencia Microbiológica para Hospitales';
const description = 'BIOHI transforma datos microbiológicos en información útil para vigilancia, equipos PROA y gestión hospitalaria mediante integración, normalización y analítica multicentro.';

const navItems = [
  ['Quiénes somos', '#quienes-somos'],
  ['Problema', '#problema'],
  ['Solución', '#solucion'],
  ['Impacto', '#impacto'],
  ['Contacto', '#contacto'],
];

const teamAreas = [
  ['01', 'Producto', 'Visión, priorización y validación del valor clínico-operativo.'],
  ['02', 'Tecnología', 'Arquitectura, integración y evolución segura de la plataforma.'],
  ['03', 'Datos y testing', 'Calidad, normalización, indicadores y verificación.'],
  ['04', 'Diseño y UX', 'Experiencias explicables para contextos de alta exigencia.'],
  ['05', 'Gestión ágil', 'Coordinación, aprendizaje continuo y entrega incremental.'],
  ['06', 'Comunicación', 'Vinculación, marca y conversación con el ecosistema.'],
];

const metrics = [
  {
    value: '1 de cada 6',
    label: 'infecciones bacterianas comunes confirmadas por laboratorio fue resistente a antibióticos en 2023, a escala mundial.',
    source: 'OMS · Resistencia antimicrobiana',
    href: 'https://www.who.int/news-room/fact-sheets/detail/antimicrobial-resistance',
  },
  {
    value: '+40 %',
    label: 'de las combinaciones patógeno–antibiótico monitoreadas mostró un aumento de resistencia entre 2018 y 2023.',
    source: 'OMS · Global antibiotic resistance surveillance report 2025',
    href: 'https://www.who.int/publications/i/item/B09585',
  },
  {
    value: '≈30 %',
    label: 'de los antibióticos prescritos en hospitales de cuidados agudos de EE. UU. son innecesarios o subóptimos.',
    source: 'CDC · Antibiotic Use in the United States',
    href: 'https://www.cdc.gov/antibiotic-use/hcp/data-research/antibiotic-prescribing.html',
  },
];

const problemCards = [
  ['Tiempo', 'tiempo', 'Horas de consolidación manual', 'Buscar, limpiar y homologar información retrasa la llegada a una conclusión útil.'],
  ['Vigilancia', 'vigilancia', 'Menor capacidad de anticipación', 'Las señales relevantes pueden aparecer tarde cuando cada fuente se analiza por separado.'],
  ['Decisiones', 'decisiones', 'Menos evidencia local disponible', 'PROA necesita información actualizada y contextualizada para priorizar su revisión.'],
] as const;

const processSteps = [
  { label: 'Datos', glyph: 'datos' as const },
  { label: 'Integración', glyph: 'integracion' as const },
  { label: 'Normalización', glyph: 'normalizacion' as const },
  { label: 'Análisis', glyph: 'analisis' as const },
  { label: 'IA y predicción', glyph: 'prediccion' as const },
  { label: 'Vigilancia', glyph: 'vigilancia' as const },
];

const clinicalBenefits = [
  ['Evidencia local', 'Información microbiológica contextualizada para comprender la realidad de cada institución.'],
  ['Seguimiento', 'Mejor lectura de tendencias, variaciones y comportamientos que merecen revisión.'],
  ['Apoyo clínico', 'Una base estructurada para vigilancia y reevaluación, sin sustituir el criterio profesional.'],
];

const operationalBenefits = [
  ['Menos consolidación manual', 'Reducir procesos repetitivos antes de comenzar el análisis.'],
  ['Información centralizada', 'Indicadores, filtros y alertas disponibles dentro de una misma plataforma.'],
  ['Reportes y seguimiento', 'Facilitar reuniones PROA, evaluación institucional y revisión periódica.'],
];

const intelligenceLayer = [
  [
    'copiloto',
    'Copiloto IA',
    'Diseñado para responder preguntas en lenguaje natural sobre datos ya validados, con el universo consultado, el período y la trazabilidad del resultado siempre a la vista.',
  ],
  [
    'alertas',
    'Alertas tempranas',
    'Cuando la resistencia de una combinación cruza el umbral que definió el equipo PROA, la alerta llega con microorganismo, antibiótico, establecimiento, período, valor actual y el motivo que la disparó.',
  ],
  [
    'prediccion',
    'Modelo predictivo',
    'Diseñado para proyectar tendencias de resistencia sobre la serie histórica consolidada, y para entregar sus límites junto con el resultado en vez de una conclusión automática.',
  ],
] as const;

const differentiators = [
  ['Multicentro', 'Preparado para consolidar información de más de una institución bajo un modelo común.'],
  ['Agnóstico al proveedor', 'Diseñado para integrarse sin depender de un único fabricante o ecosistema.'],
  ['Trazable por diseño', 'Cada carga y cada consulta queda en bitácora, y cada indicador muestra el universo con que fue calculado.'],
];
---

<BaseLayout {title} {description}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header" data-header>
    <div class="container nav-shell">
      <a class="brand" href="#inicio" aria-label="BIOHI, volver al inicio">
        <img src="/biohi-logo.svg" width="126" height="39" alt="BIOHI" />
      </a>

      <nav class="desktop-nav" aria-label="Navegación principal">
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>

      <a class="button button-small desktop-cta" href="#contacto">Conversemos</a>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Navegación móvil" data-mobile-menu hidden>
      {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="mobile-nav-cta" href="#contacto">Conversemos <span aria-hidden="true">↘</span></a>
    </nav>
  </header>

  <div class="brand-intro" data-brand-intro aria-hidden="true">
    <div class="brand-intro-backdrop" data-intro-backdrop></div>
    <LogoAnimated />
  </div>

  <main id="contenido">
    <section id="inicio" class="hero section-grid" aria-labelledby="hero-title">
      <AgarField />
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Inteligencia microbiológica</p>
          <h1 id="hero-title">Transformamos datos microbiológicos en <em>inteligencia para actuar a tiempo.</em></h1>
          <p class="hero-lead">BIOHI integra, normaliza y analiza datos microbiológicos de distintos establecimientos para convertir información dispersa en evidencia útil para vigilancia, equipos PROA y gestión hospitalaria.</p>
          <div class="hero-actions">
            <a class="button" href="#solucion">Conoce BIOHI <span aria-hidden="true">↘</span></a>
            <a class="button button-secondary" href="#contacto">Conversemos</a>
          </div>
        </div>

        <div class="hero-mascot">
          <img
            src="/biohi-mascot.webp"
            alt="Mascota de BIOHI con bata de laboratorio"
            width="1024"
            height="1536"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="hero-signals">
          <div class="signal-row">
            <div><span>01</span><strong>Integrar</strong></div>
            <div><span>02</span><strong>Normalizar</strong></div>
            <div><span>03</span><strong>Vigilar</strong></div>
          </div>
        </div>
      </div>

      <div class="container hero-footer">
        <span>Microbiología clínica</span>
        <a class="scroll-cue" href="#quienes-somos">Explorar plataforma <i aria-hidden="true">↓</i></a>
        <span>Chile · 2026</span>
      </div>
    </section>

    <section id="quienes-somos" class="section about-section" aria-labelledby="about-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> BIOHI</p>
            <p class="section-index">01 / 05</p>
          </div>
          <div>
            <h2 id="about-title">Una nueva capa de inteligencia para microbiología clínica.</h2>
            <p class="section-lead">BIOHI es una plataforma tecnológica orientada a hospitales y redes asistenciales que transforma datos microbiológicos dispersos en información estructurada, comparable y accionable.</p>
          </div>
        </div>

        <div class="vision-block" data-reveal>
          <div class="vision-topline"><span>Nuestra visión</span><span>INFRAESTRUCTURA MULTICENTRO</span></div>
          <blockquote>
            Ser la red global de inteligencia microbiológica que anticipe la resistencia antimicrobiana y transforme
            <span> evidencia en acción </span> para erradicar su impacto.
          </blockquote>
        </div>

        <div class="team-block">
          <div class="team-heading" data-reveal>
            <div>
              <p class="subeyebrow">Equipo</p>
              <h3>Multidisciplina para un problema complejo.</h3>
            </div>
            <p>BIOHI es desarrollado por un equipo de Ingeniería Civil Informática de la Universidad Técnica Federico Santa María, con responsabilidades distribuidas en producto, tecnología, datos, seguridad, experiencia y comunicación.</p>
          </div>
          <div class="team-grid">
            {teamAreas.map(([number, area, copy], index) => (
              <article class="team-card" data-reveal data-delay={String((index % 3) * 70)}>
                <span>{number}</span>
                <h4>{area}</h4>
                <p>{copy}</p>
              </article>
            ))}
          </div>
        </div>

        <InstitutionalStrip />
      </div>
    </section>

    <section id="problema" class="section problem-section" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> El desafío</p>
            <p class="section-index">02 / 05</p>
          </div>
          <div>
            <h2 id="problem-title">Los datos existen. La resistencia exige contexto.</h2>
            <p class="section-lead">BIOHI convierte información microbiológica fragmentada en evidencia local para apoyar decisiones oportunas.</p>
          </div>
        </div>

        <div class="metrics-grid">
          {metrics.map((metric, index) => (
            <article class="metric-card" data-reveal data-delay={String(index * 80)}>
              <span class="metric-number">0{index + 1}</span>
              <strong>{metric.value}</strong>
              <p>{metric.label}</p>
              <a href={metric.href} target="_blank" rel="noreferrer">{metric.source} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="source-context">Las cifras describen contextos globales o de EE. UU.; no representan resultados propios de BIOHI ni prevalencia local chilena.</p>

        <div class="fragmentation-block" data-reveal>
          <div class="fragment-copy">
            <p class="subeyebrow">Datos microbiológicos dispersos</p>
            <h3>El problema no es la ausencia de datos.</h3>
            <p>La información ya existe, pero está dispersa entre sistemas y formatos. Antes de analizarla, los equipos deben consolidarla y homologarla manualmente.</p>
          </div>
          <FragmentFlow />
        </div>

        <div class="hospital-impact">
          <div class="subsection-heading" data-reveal>
            <p class="subeyebrow">Impacto en hospitales y PROA</p>
            <h3>Cuando la información no está integrada, el costo también es operativo.</h3>
          </div>
          <div class="problem-card-grid">
            {problemCards.map(([tag, glyph, heading, copy], index) => (
              <article class="problem-card" data-reveal data-delay={String(index * 70)}>
                <span>{tag}</span>
                <ImpactGlyph kind={glyph} />
                <h4>{heading}</h4>
                <p>{copy}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="solucion" class="section solution-section" aria-labelledby="solution-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> La plataforma</p>
            <p class="section-index">03 / 05</p>
          </div>
          <div>
            <h2 id="solution-title">De datos dispersos a inteligencia microbiológica.</h2>
            <p class="section-lead">BIOHI consolida datos microbiológicos anonimizados, los transforma a un modelo común y construye una capa de análisis para vigilancia y gestión hospitalaria.</p>
          </div>
        </div>

        <ol class="process-flow" data-reveal aria-label="Proceso de BIOHI">
          {processSteps.map((step, index) => (
            <li>
              <div class="process-mark">
                <span>0{index + 1}</span>
                <ProcessGlyph step={step.glyph} />
              </div>
              <strong>{step.label}</strong>
              {index < processSteps.length - 1 && <i aria-hidden="true">→</i>}
            </li>
          ))}
        </ol>

        <AntibiogramGrid />

        <aside class="clinical-note" data-reveal>
          <p class="clinical-note-label">Principio clínico</p>
          <div class="clinical-note-copy">
            <p class="clinical-note-heading">BIOHI no busca reemplazar el juicio clínico.</p>
            <p>Busca fortalecerlo con información mejor estructurada, explicable y trazable.</p>
          </div>
        </aside>
      </div>
    </section>

    <section id="impacto" class="section impact-section" aria-labelledby="impact-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Impacto</p>
            <p class="section-index">04 / 05</p>
          </div>
          <div>
            <h2 id="impact-title">Información mejor aprovechada. Decisiones mejor respaldadas.</h2>
            <p class="section-lead">El valor de BIOHI no está únicamente en centralizar información, sino en reducir la distancia entre los datos microbiológicos y su utilización práctica.</p>
          </div>
        </div>

        <div class="benefits-grid">
          <div class="benefit-column" data-reveal>
            <div class="benefit-column-head"><span>01</span><div><small>Beneficios clínicos</small><h3>Más contexto para revisar.</h3></div></div>
            <div class="benefit-list">
              {clinicalBenefits.map(([heading, copy]) => <article><h4>{heading}</h4><p>{copy}</p><span aria-hidden="true">↗</span></article>)}
            </div>
          </div>
          <div class="benefit-column" data-reveal data-delay="100">
            <div class="benefit-column-head"><span>02</span><div><small>Beneficios operativos</small><h3>Menos fricción para analizar.</h3></div></div>
            <div class="benefit-list">
              {operationalBenefits.map(([heading, copy]) => <article><h4>{heading}</h4><p>{copy}</p><span aria-hidden="true">↗</span></article>)}
            </div>
          </div>
        </div>

        <div class="differentiation-block">
          <div class="subsection-heading" data-reveal>
            <p class="subeyebrow">Diferenciación</p>
            <h3>No es un repositorio con dashboards. Es una capa de inteligencia sobre los datos consolidados.</h3>
            <p>Con los datos de distintos establecimientos bajo un modelo común, BIOHI está diseñado para responder preguntas en lenguaje natural, avisar cuando una resistencia cruza el umbral que definió el propio equipo PROA y proyectar tendencias sobre la serie histórica consolidada.</p>
          </div>
          <div class="intelligence-panel" data-reveal>
            <p class="subeyebrow">Capa de inteligencia</p>
            <div class="intelligence-grid">
              {intelligenceLayer.map(([glyph, heading, copy]) => (
                <article class="intelligence-item">
                  <IntelligenceGlyph kind={glyph} />
                  <h4>{heading}</h4>
                  <p>{copy}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="differentiator-grid">
            {differentiators.map(([heading, copy], index) => (
              <article data-reveal data-delay={String(index * 70)}><span>0{index + 1}</span><h4>{heading}</h4><p>{copy}</p></article>
            ))}
          </div>
        </div>

        <blockquote class="closing-quote" data-reveal>“No proponemos solamente otro software de laboratorio. Construimos una infraestructura digital para convertir datos microbiológicos en inteligencia útil para vigilancia y toma de decisiones.”</blockquote>
      </div>
    </section>

    <section id="contacto" class="section contact-section" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="contact-copy" data-reveal>
          <p class="eyebrow"><span></span> Contacto</p>
          <h2 id="contact-title">Convirtamos datos microbiológicos en inteligencia útil.</h2>
          <p>Si formas parte de un hospital, equipo PROA, laboratorio, institución de salud u organización interesada en innovación aplicada a resistencia antimicrobiana, conversemos.</p>
          <div class="contact-note"><span><ChileFlag class="flag-cl-badge" /></span><p><strong>Desarrollado en Chile.</strong><br />Con una visión multicentro para el ecosistema de salud.</p></div>
          <div class="social-status">
            <small>Síguenos</small>
            <a href="https://www.instagram.com/biohi.cl/" target="_blank" rel="noreferrer" aria-label="Instagram de BIOHI">Instagram ↗</a>
            <span>LinkedIn · próximamente</span>
          </div>
        </div>

        <form class="contact-form" id="contact-form" data-reveal data-delay="100" novalidate>
          <div class="form-heading"><span>Hablemos</span><span>05 / 05</span></div>
          <div class="field-row">
            <label>Nombre<input type="text" name="nombre" autocomplete="name" required placeholder="Tu nombre" /></label>
            <label>Institución<input type="text" name="institucion" autocomplete="organization" required placeholder="Hospital u organización" /></label>
          </div>
          <div class="field-row">
            <label>Cargo<input type="text" name="cargo" autocomplete="organization-title" required placeholder="Tu rol" /></label>
            <label>Correo<input type="email" name="correo" autocomplete="email" required placeholder="nombre@institucion.cl" /></label>
          </div>
          <label>Mensaje<textarea name="mensaje" rows="5" required placeholder="Cuéntanos brevemente en qué podemos colaborar"></textarea></label>
          <button class="button form-submit" type="submit">Redactar el correo <span aria-hidden="true">↗</span></button>
          <p class="form-privacy">Se abre tu propio cliente de correo con el mensaje ya redactado. Los datos no pasan por ningún servidor de BIOHI ni por un servicio de terceros: el correo lo envías tú.</p>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <div class="footer-brand"><img src="/biohi-logo.svg" width="154" height="48" alt="BIOHI" /><p>Plataforma inteligente para<br />microbiología clínica.</p></div>
      <nav aria-label="Navegación del pie de página">{navItems.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
      <div class="footer-social"><a href="https://www.instagram.com/biohi.cl/" target="_blank" rel="noreferrer" aria-label="Instagram de BIOHI">Instagram ↗</a><span>LinkedIn · próximamente</span></div>
    </div>
    <div class="container footer-bottom"><span>© 2026 BIOHI. Todos los derechos reservados.</span><span>Desarrollado en Chile.</span><a href="#inicio">Volver arriba ↑</a></div>
  </footer>

  <script>
    const pageRoot = document.documentElement;
    pageRoot.classList.add('js', 'intro-active');

    const menuButton = document.querySelector('[data-menu-toggle]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    const closeMenu = () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Abrir menú');
      if (mobileMenu instanceof HTMLElement) mobileMenu.hidden = true;
    };

    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      if (mobileMenu instanceof HTMLElement) mobileMenu.hidden = isOpen;
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        if (menuButton instanceof HTMLElement) menuButton.focus();
      }
    });

    const header = document.querySelector('[data-header]');
    const setHeaderState = () => header?.classList.toggle('scrolled', window.scrollY > 24);
    setHeaderState();
    window.addEventListener('scroll', setHeaderState, { passive: true });

    const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          element.style.transitionDelay = `${element.dataset.delay ?? 0}ms`;
          element.classList.add('is-visible');
          observer.unobserve(element);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -36px' });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }

    // ── Introduccion de marca: carga centrada → navbar ───────────────────
    const brandIntro = document.querySelector<HTMLElement>('[data-brand-intro]');
    const introBackdrop = document.querySelector<HTMLElement>('[data-intro-backdrop]');
    const introMark = brandIntro?.querySelector<HTMLElement>('.brandmark');
    const headerLogo = document.querySelector<HTMLElement>('.brand img');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let landingAnimation: Animation | undefined;
    let introAnimations: Animation[] = [];
    let introFinished = false;

    const skipKeys = new Set(['ArrowDown', 'PageDown', 'End', ' ', 'Spacebar']);
    const accelerateIntro = (event?: Event) => {
      if (event instanceof KeyboardEvent && !skipKeys.has(event.key)) return;
      landIntro(true);
    };

    const removeIntroListeners = () => {
      window.removeEventListener('wheel', accelerateIntro);
      window.removeEventListener('touchmove', accelerateIntro);
      window.removeEventListener('scroll', accelerateIntro);
      window.removeEventListener('keydown', accelerateIntro);
    };

    const finishIntro = () => {
      if (introFinished) return;
      introFinished = true;
      removeIntroListeners();
      pageRoot.classList.remove('intro-active', 'intro-landing', 'intro-skip');
      pageRoot.classList.add('intro-complete');
      brandIntro?.remove();
    };

    function landIntro(fast = false) {
      if (introFinished || !brandIntro || !introMark || !headerLogo) {
        finishIntro();
        return;
      }

      if (landingAnimation) {
        if (fast) introAnimations.forEach((animation) => { animation.playbackRate = 4; });
        return;
      }

      if (fast) pageRoot.classList.add('intro-skip');

      const mark = introMark.getBoundingClientRect();
      const target = headerLogo.getBoundingClientRect();
      if (!mark.width || !target.width) {
        finishIntro();
        return;
      }

      const duration = reduceMotion.matches ? 1 : fast ? 280 : 820;
      const transform = `translate3d(${target.left - mark.left}px, ${target.top - mark.top}px, 0) scale(${target.width / mark.width})`;
      pageRoot.classList.add('intro-landing');

      landingAnimation = introMark.animate([
        { transform: 'translate3d(0, 0, 0) scale(1)' },
        { transform },
      ], {
        duration,
        easing: 'cubic-bezier(.22,.72,.18,1)',
        fill: 'forwards',
      });

      const animations: Animation[] = [landingAnimation];
      if (introBackdrop) {
        animations.push(introBackdrop.animate([
          { opacity: 1 },
          { opacity: 0 },
        ], {
          duration: Math.max(180, duration * .72),
          delay: duration * .18,
          easing: 'ease-out',
          fill: 'forwards',
        }));
      }

      introAnimations = animations;
      Promise.all(animations.map((animation) => animation.finished)).then(finishIntro, finishIntro);
    }

    if (!brandIntro || !introMark || !headerLogo) {
      finishIntro();
    } else if (reduceMotion.matches) {
      landIntro(true);
    } else {
      window.addEventListener('wheel', accelerateIntro, { passive: true });
      window.addEventListener('touchmove', accelerateIntro, { passive: true });
      window.addEventListener('scroll', accelerateIntro, { passive: true });
      window.addEventListener('keydown', accelerateIntro);

      const pageLoaded = document.readyState === 'complete'
        ? Promise.resolve()
        : new Promise<void>((resolve) => window.addEventListener('load', () => resolve(), { once: true }));
      const logoDrawn = new Promise<void>((resolve) => window.setTimeout(resolve, 3500));
      Promise.all([pageLoaded, logoDrawn]).then(() => landIntro());
      window.setTimeout(() => landIntro(true), 8000);
    }

    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a');
    const observedSections = [...navLinks]
      .map((link) => document.querySelector(link.hash))
      .filter((section): section is Element => Boolean(section));
    const activeObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      });
    }, { rootMargin: '-38% 0px -54%' });
    observedSections.forEach((section) => activeObserver.observe(section));

    // El sitio es estatico, asi que no hay servidor propio que despache el
    // correo. El formulario compone un mailto y lo entrega al cliente del
    // visitante: los datos nunca pasan por un tercero, pero el envio final
    // lo hace la persona. Por eso el estado siempre deja la direccion a la
    // vista, que es el respaldo si no tiene cliente configurado.
    const BUZON = '123biohi@gmail.com';
    const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
    const formStatus = document.querySelector<HTMLElement>('#form-status');

    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        if (formStatus) formStatus.textContent = 'Revisa los campos obligatorios antes de continuar.';
        return;
      }

      const datos = new FormData(contactForm);
      const campo = (nombre: string) => String(datos.get(nombre) ?? '').trim();

      const asunto = `Contacto BIOHI · ${campo('institucion')}`;
      const cuerpo = [
        `Nombre: ${campo('nombre')}`,
        `Institución: ${campo('institucion')}`,
        `Cargo: ${campo('cargo')}`,
        `Correo: ${campo('correo')}`,
        '',
        campo('mensaje'),
      ].join('\n');

      const enlace = `mailto:${BUZON}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;

      // Varios clientes truncan el mailto pasados unos 2000 caracteres, y un
      // correo cortado a la mitad es peor que un aviso claro.
      if (enlace.length > 1900) {
        if (formStatus) {
          formStatus.textContent = `El mensaje es muy largo para abrirlo en tu cliente de correo. Acórtalo o escríbenos directamente a ${BUZON}.`;
        }
        return;
      }

      if (formStatus) {
        formStatus.textContent = `Se abrirá tu cliente de correo con el mensaje listo para enviar a ${BUZON}. Si no se abre, escríbenos directamente a esa dirección.`;
      }
      window.location.href = enlace;
    });
  </script>
</BaseLayout>
