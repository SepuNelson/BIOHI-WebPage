---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const title = 'BIOHI | Inteligencia Microbiológica para Hospitales';
const description = 'BIOHI transforma datos microbiológicos en información útil para vigilancia, equipos PROA y gestión hospitalaria mediante integración, normalización y analítica multicentro.';

const navItems = [
  ['Quiénes somos', '#quienes-somos'],
  ['Problema', '#problema'],
  ['Solución', '#solucion'],
  ['Impacto', '#impacto'],
  ['Preguntas', '#faq'],
  ['Contacto', '#contacto'],
];

// B11 — tagline reveal. Words light up one at a time in reading order.
const taglineLines = [
  'Los datos ya existen dentro de tu hospital.',
  'BIOHI los vuelve comparables, trazables y listos para la próxima reunión PROA.',
];
const taglineAccent = new Set(['BIOHI', 'comparables,', 'trazables']);

// A4 — risk reversal.
const assurances = [
  ['seal-check', 'Revisión inicial sin costo', 'Analizamos una muestra de tus registros y devolvemos un informe de factibilidad antes de cualquier compromiso.'],
  ['shield-check', 'Piloto acotado', 'Partimos con un establecimiento y un período definido. Si no entrega evidencia útil, no se escala.'],
  ['lock-key', 'Tus datos siguen siendo tuyos', 'Trabajamos sobre datos anonimizados y puedes solicitar su eliminación en cualquier momento.'],
];

// A2 / A7 — FAQ, written plainly so it also answers well in search.
const faqItems = [
  [
    '¿BIOHI reemplaza el sistema de laboratorio del hospital?',
    'No. BIOHI se conecta sobre lo que ya existe. Recibe datos de cultivos y antibiogramas desde el LIS u otras fuentes, los normaliza a un modelo común y agrega la capa de vigilancia y analítica. El sistema de laboratorio sigue operando igual.',
  ],
  [
    '¿Qué datos necesita BIOHI para funcionar?',
    'Registros de cultivo y susceptibilidad antimicrobiana: microorganismo, antibiótico, interpretación, tipo de muestra, fecha y establecimiento. Trabajamos con datos sintéticos o previamente anonimizados, sin identificadores directos de pacientes.',
  ],
  [
    '¿Cómo se manejan los datos de pacientes?',
    'BIOHI opera sobre datos anonimizados: no almacena nombres, RUT ni identificadores directos. El acceso es por roles, las acciones relevantes quedan registradas en bitácora y cada análisis conserva el universo consultado, los filtros y la regla aplicada.',
  ],
  [
    '¿Qué pasa si cada hospital nombra distinto los microorganismos y antibióticos?',
    'Es el caso habitual y por eso la homologación es parte del proceso. BIOHI mapea las nomenclaturas locales a un modelo común y conserva el valor original de cada registro para mantener la trazabilidad.',
  ],
  [
    '¿Cuánto demora una integración?',
    'Depende de la calidad y del formato de origen. Una carga estructurada inicial permite ver indicadores en pocas semanas. La conexión automatizada con el LIS se define caso a caso durante el levantamiento técnico.',
  ],
  [
    '¿Sirve para un solo hospital o necesito una red?',
    'Funciona con un establecimiento. El modelo común está diseñado para que, cuando se sumen otros centros, la comparación entre establecimientos y territorios no obligue a rehacer el trabajo ya hecho.',
  ],
  [
    '¿BIOHI decide qué antibiótico indicar?',
    'No. BIOHI no emite indicaciones terapéuticas ni reemplaza el juicio clínico. Entrega evidencia local estructurada, explicable y trazable para que microbiología y los equipos PROA la revisen y decidan.',
  ],
  [
    '¿En qué etapa está el producto?',
    'En desarrollo y validación progresiva junto a profesionales vinculados a PROA, microbiología hospitalaria y actores del ecosistema de diagnóstico. Las conversaciones actuales son de levantamiento y pilotaje.',
  ],
];

// A7 — Rich Schema graph (Organization, SoftwareApplication, WebSite, FAQPage) for answer engines and SEO.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://biohi.cl/#organization',
      name: 'BIOHI',
      url: 'https://biohi.cl',
      logo: 'https://biohi.cl/biohi-logo.svg',
      description: 'Plataforma de inteligencia microbiológica para hospitales y redes asistenciales.',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://biohi.cl/#software',
      name: 'BIOHI',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Web',
      description: 'Inteligencia microbiológica para vigilancia hospitalaria, equipos PROA y gestión asistencial.',
      publisher: { '@id': 'https://biohi.cl/#organization' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://biohi.cl/#website',
      url: 'https://biohi.cl',
      name: 'BIOHI',
      publisher: { '@id': 'https://biohi.cl/#organization' },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://biohi.cl/#faq',
      mainEntity: faqItems.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};

const teamAreas = [
  ['01', 'Producto', 'Visión, priorización y validación del valor clínico y operativo.'],
  ['02', 'Tecnología', 'Arquitectura, integración y evolución segura de la plataforma.'],
  ['03', 'Datos y testing', 'Calidad, normalización, indicadores y verificación.'],
  ['04', 'Diseño y UX', 'Experiencias explicables para contextos de alta exigencia.'],
  ['05', 'Gestión ágil', 'Coordinación, aprendizaje continuo y entrega incremental.'],
  ['06', 'Comunicación', 'Vinculación, marca y conversación con el ecosistema.'],
];

const metrics = [
  {
    value: '1 de cada 6',
    label: 'infecciones bacterianas comunes confirmadas por laboratorio fue resistente a antibióticos en 2023, a escala mundial.',
    source: 'OMS · Resistencia antimicrobiana',
    href: 'https://www.who.int/news-room/fact-sheets/detail/antimicrobial-resistance',
  },
  {
    value: '+40 %',
    label: 'de las combinaciones patógeno–antibiótico monitoreadas mostró un aumento de resistencia entre 2018 y 2023.',
    source: 'OMS · Global antibiotic resistance surveillance report 2025',
    href: 'https://www.who.int/publications/i/item/B09585',
  },
  {
    value: '≈30 %',
    label: 'de los antibióticos prescritos en hospitales de cuidados agudos de EE. UU. son innecesarios o subóptimos.',
    source: 'CDC · Antibiotic Use in the United States',
    href: 'https://www.cdc.gov/antibiotic-use/hcp/data-research/antibiotic-prescribing.html',
  },
];

const problemCards = [
  ['Tiempo', 'Horas de consolidación manual', 'Buscar, limpiar y homologar información retrasa la llegada a una conclusión útil.'],
  ['Vigilancia', 'Menor capacidad de anticipación', 'Las señales relevantes pueden aparecer tarde cuando cada fuente se analiza por separado.'],
  ['Decisiones', 'Menos evidencia local disponible', 'PROA necesita información actualizada y contextualizada para priorizar su revisión.'],
];

const integrationItems = [
  'Carga de datos estructurados',
  'Validación de campos',
  'Control de anonimización',
  'Homologación de microorganismos',
  'Homologación de antibióticos',
  'Normalización de interpretaciones',
  'Valor original para trazabilidad',
];

const analyticsItems = [
  'Porcentaje de resistencia',
  'Tendencias temporales',
  'Combinaciones microorganismo–antibiótico',
  'Comparación entre períodos',
  'Análisis por establecimiento y territorio',
  'Filtros por muestra y grupo etario',
];

const traceabilityTags = [
  'Período analizado',
  'Hospital',
  'Filtros',
  'N.º de registros',
  'Universo consultado',
  'Regla aplicada',
  'Fecha de generación',
];

const securityCards = [
  ['01', 'Datos anonimizados', 'Datos sintéticos o previamente anonimizados, sin identificadores directos.'],
  ['02', 'Acceso por roles', 'Cada perfil accede solo a las capacidades que necesita para su trabajo.'],
  ['03', 'Bitácoras', 'Las acciones relevantes quedan disponibles para auditoría y trazabilidad.'],
  ['04', 'Información explicable', 'Cada análisis conserva universo, filtros, contexto y regla aplicada.'],
];

const clinicalBenefits = [
  ['Evidencia local', 'Información microbiológica contextualizada para comprender la realidad de cada institución.'],
  ['Seguimiento', 'Mejor lectura de tendencias, variaciones y comportamientos que merecen revisión.'],
  ['Apoyo clínico', 'Una base estructurada para vigilancia y reevaluación, sin sustituir el criterio profesional.'],
];

const operationalBenefits = [
  ['Menos consolidación manual', 'Reducir procesos repetitivos antes de comenzar el análisis.'],
  ['Información centralizada', 'Indicadores, filtros y alertas disponibles dentro de una misma plataforma.'],
  ['Reportes y seguimiento', 'Facilitar reuniones PROA, evaluación institucional y revisión periódica.'],
];

const differentiators = [
  ['Multicentro', 'Preparado para consolidar información de más de una institución bajo un modelo común.'],
  ['Agnóstico al proveedor', 'Diseñado para integrarse sin depender de un único fabricante o ecosistema.'],
  ['Orientado a inteligencia', 'No se limita a almacenar: estructura datos para vigilancia, análisis y gestión.'],
];
---

<BaseLayout {title} {description} jsonLd={structuredData}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header" data-header data-open="false">
    <div class="container nav-shell">
      <a class="brand" href="#inicio" aria-label="BIOHI, volver al inicio">
        <img src="/biohi-logo.svg" width="126" height="39" alt="BIOHI" />
      </a>

      <nav class="desktop-nav" aria-label="Navegación principal">
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>

      <a class="button button-small desktop-cta" href="#contacto">Conversemos</a>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Navegación móvil" data-mobile-menu hidden>
      {navItems.map(([label, href]) => (
        <a href={href}>{label}<Icon name="arrow-up-right" class="icon" /></a>
      ))}
      <a class="mobile-nav-cta" href="#contacto">Conversemos<Icon name="arrow-down-right" class="icon" /></a>
    </nav>
  </header>

  <main id="contenido">
    <section id="inicio" class="hero section-grid" aria-labelledby="hero-title">
      <div class="hero-orbit orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit orbit-two" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span></span> Inteligencia microbiológica</p>
          <h1 id="hero-title">Transformamos datos<br />microbiológicos en<br /><em>inteligencia para<br />actuar a tiempo.</em></h1>
          <p class="hero-lead">BIOHI integra, normaliza y analiza datos microbiológicos de distintos establecimientos para convertir información dispersa en evidencia útil para vigilancia, equipos PROA y gestión hospitalaria.</p>
          <div class="hero-actions">
            <a class="button" href="#contacto">Conversemos con el equipo<Icon name="arrow-down-right" class="icon button-icon" /></a>
          </div>
          <div class="trust-line" aria-label="Principios de BIOHI">
            <span>Multicentro</span><i></i><span>Trazable</span><i></i><span>Apoyo a PROA</span>
          </div>
        </div>

        <div class="data-orbit" data-reveal data-delay="120" aria-label="Flujo de datos desde hospitales hacia la inteligencia microbiológica de BIOHI">
          <div class="orbit-meta"><span>RED CLÍNICA / 05 NODOS</span><span class="live-dot">SISTEMA ACTIVO</span></div>
          <div class="network-canvas" aria-hidden="true">
            <span class="node node-a">H01</span>
            <span class="node node-b">H02</span>
            <span class="node node-c">H03</span>
            <span class="node node-d">H04</span>
            <span class="node node-e">H05</span>
            <span class="network-line line-a"></span>
            <span class="network-line line-b"></span>
            <span class="network-line line-c"></span>
            <span class="network-line line-d"></span>
            <div class="biohi-core"><span>BIO</span><strong>HI</strong><small>motor de inteligencia</small></div>
          </div>
          <div class="signal-row">
            <div><span>01</span><strong>Integrar</strong></div>
            <div><span>02</span><strong>Normalizar</strong></div>
            <div><span>03</span><strong>Vigilar</strong></div>
          </div>
        </div>
      </div>

      <div class="container hero-footer">
        <span>Microbiología clínica</span>
        <a class="scroll-cue" href="#quienes-somos">Explorar plataforma<Icon name="arrow-down" class="icon icon-sm" /></a>
        <span>Chile · 2026</span>
      </div>
    </section>

    <section id="quienes-somos" class="section about-section" aria-labelledby="about-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> BIOHI</p>
            <p class="section-index">01 / 06</p>
          </div>
          <div>
            <h2 id="about-title">Una nueva capa de inteligencia para microbiología clínica.</h2>
            <p class="section-lead">BIOHI es una plataforma tecnológica orientada a hospitales y redes asistenciales que transforma datos microbiológicos dispersos en información estructurada, comparable y accionable.</p>
          </div>
        </div>

        <div class="about-editorial" data-reveal>
          <div class="editorial-label">Qué es BIOHI</div>
          <div class="editorial-copy">
            <p>Los hospitales generan cada día cultivos, antibiogramas y resultados de susceptibilidad, pero esa información queda repartida entre sistemas, formatos y establecimientos distintos.</p>
            <p>BIOHI conecta integración, normalización, vigilancia y analítica en una sola plataforma, para microbiología, equipos clínicos, PROA y gestión.</p>
          </div>
          <p class="editorial-statement">Del dato aislado<br /><strong>a la evidencia local.</strong><br /><span>Y de ahí a vigilancia multicentro.</span></p>
        </div>


        <div class="team-block">
          <div class="team-heading" data-reveal>
            <div>
              <p class="subeyebrow">Equipo</p>
              <h3>Multidisciplina para un problema complejo.</h3>
            </div>
            <p>BIOHI es desarrollado por un equipo de Ingeniería Civil Informática de la Universidad Técnica Federico Santa María, con responsabilidades distribuidas en producto, tecnología, datos, seguridad, experiencia y comunicación.</p>
          </div>
          <div class="team-areas">
            {teamAreas.map(([number, area]) => (
              <span><i>{number}</i>{area}</span>
            ))}
          </div>
          <p class="pending-note">Los perfiles personales y sus enlaces profesionales se publicarán cuando exista autorización individual.</p>
        </div>
      </div>
    </section>

    <section id="problema" class="section problem-section" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> El desafío</p>
            <p class="section-index">02 / 06</p>
          </div>
          <div>
            <h2 id="problem-title">Los datos existen. El problema es convertirlos en información útil.</h2>
            <p class="section-lead">La resistencia antimicrobiana ocurre cuando los microorganismos dejan de responder a tratamientos que antes eran efectivos, y exige decisiones más rápidas y ajustadas a la realidad local. Los hospitales ya generan los datos que permitirían tomarlas; su fragmentación limita la capacidad de analizarlos a tiempo.</p>
          </div>
        </div>

        <div class="metrics-grid">
          {metrics.map((metric, index) => (
            <article class="metric-card" data-reveal data-delay={String(index * 80)}>
              <span class="metric-number">0{index + 1}</span>
              <strong>{metric.value}</strong>
              <p>{metric.label}</p>
              <a href={metric.href} target="_blank" rel="noreferrer">{metric.source}<Icon name="arrow-up-right" class="icon icon-sm" /></a>
            </article>
          ))}
        </div>
        <p class="source-context">Las cifras describen contextos globales o de EE. UU.; no representan resultados propios de BIOHI ni prevalencia local chilena.</p>

        <div class="fragmentation-block" data-reveal>
          <div class="fragment-copy">
            <p class="subeyebrow">Datos microbiológicos dispersos</p>
            <h3>El problema no es la ausencia de datos.</h3>
            <p>Laboratorio y microbiología generan información todos los días, pero puede quedar distribuida entre sistemas, archivos, nomenclaturas y establecimientos distintos. Antes de analizarla, los equipos deben buscar, consolidar, validar y homologar.</p>
          </div>
          <div class="fragment-consequences">
            {problemCards.map(([tag, heading, copy]) => (
              <div><span>{tag}</span><strong>{heading}</strong><small>{copy}</small></div>
            ))}
          </div>
          <div class="fragment-diagram" aria-label="Laboratorios y hospital alimentan datos fragmentados que requieren consolidación manual">
            <div class="source-stack">
              <span>Laboratorio A</span>
              <span>Laboratorio B</span>
              <span>Hospital C</span>
            </div>
            <div class="merge-line" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
            <div class="fragment-output">
              <span class="status-chip">Fuentes heterogéneas</span>
              <strong>Consolidación manual</strong>
              <small>buscar · limpiar · homologar</small>
            </div>
          </div>
        </div>

      </div>
    </section>

    <section id="solucion" class="section solution-section" aria-labelledby="solution-title">
      <div class="container">
        <div class="section-intro split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> La plataforma</p>
            <p class="section-index">03 / 06</p>
          </div>
          <div>
            <h2 id="solution-title">De datos dispersos a inteligencia microbiológica.</h2>
            <p class="section-lead">BIOHI consolida datos microbiológicos anonimizados, los transforma a un modelo común y construye una capa de análisis para vigilancia y gestión hospitalaria.</p>
          </div>
        </div>

        <ol class="process-flow" data-reveal aria-label="Proceso de BIOHI">
          {['Datos', 'Integración', 'Normalización', 'Análisis', 'Vigilancia'].map((step, index) => (
            <li>
              <span>0{index + 1}</span>
              <strong>{step}</strong>
              {index < 4 && <i aria-hidden="true">→</i>}
            </li>
          ))}
        </ol>

        <div class="capabilities-grid">
          <article class="capability-panel" data-reveal>
            <div class="capability-head">
              <span>01 / Integración</span>
              <h3>Distintos formatos.<br /><em>Un lenguaje común.</em></h3>
            </div>
            <ul class="check-list">
              {integrationItems.map((item) => <li><Icon name="check" class="icon icon-sm" />{item}</li>)}
            </ul>
          </article>

          <article class="capability-panel capability-panel-accent" data-reveal data-delay="100">
            <div class="capability-head">
              <span>02 / Analítica</span>
              <h3>Comprender el comportamiento, <em>no solo visualizarlo.</em></h3>
            </div>
            <ul class="check-list">
              {analyticsItems.map((item) => <li><Icon name="check" class="icon icon-sm" />{item}</li>)}
            </ul>
          </article>
        </div>

        <aside class="clinical-note" data-reveal>
          <span class="clinical-note-mark"><Icon name="warning" class="icon" /></span>
          <p><strong>BIOHI no busca reemplazar el juicio clínico.</strong> Busca fortalecerlo con información mejor estructurada, explicable y trazable.</p>
          <span class="clinical-note-label">PRINCIPIO DE DISEÑO</span>
        </aside>

        <div class="product-showcase" data-reveal>
          <div class="product-copy">
            <p class="subeyebrow">Producto</p>
            <h3>Una interfaz diseñada para comprender, no solo visualizar.</h3>
            <p>Indicadores, tendencias y alertas en un solo lugar, sin procesos manuales adicionales.</p>
            <ul>
              <li><span>01</span> Indicadores y tendencia</li>
              <li><span>02</span> Segmentación con contexto</li>
              <li><span>03</span> Alertas explicables</li>
            </ul>
          </div>

          <div class="dashboard-frame" aria-label="Mockup conceptual del dashboard BIOHI con datos sintéticos">
            <div class="dashboard-titlebar">
              <div class="dashboard-brand"><img src="/biohi-logo.svg" width="86" height="27" alt="" /></div>
              <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
              <span>Datos sintéticos · Demo</span>
            </div>
            <div class="dashboard-body">
              <aside class="dash-sidebar" aria-hidden="true">
                <span class="dash-brand-dot"></span>
                <i class="active"></i><i></i><i></i><i></i><i></i>
              </aside>
              <div class="dash-main">
                <div class="dash-heading"><div><small>CENTRO DE VIGILANCIA</small><strong>Resumen microbiológico</strong></div><button type="button" tabindex="-1">Exportar</button></div>
                <div class="dash-filters">
                  <span><small>Microorganismo</small><strong>E. coli⌄</strong></span>
                  <span><small>Antibiótico</small><strong>Ciprofloxacino⌄</strong></span>
                  <span><small>Establecimiento</small><strong>Centro 03⌄</strong></span>
                  <span><small>Período</small><strong>Últimos 6 meses⌄</strong></span>
                </div>
                <div class="dash-content-grid">
                  <div class="kpi-card">
                    <div><small>RESISTENCIA OBSERVADA</small><span>Dato demostrativo</span></div>
                    <strong>18,4<em>%</em></strong>
                    <p><i></i> 2.418 registros normalizados</p>
                  </div>
                  <div class="alert-panel">
                    <small>ALERTAS PARA REVISIÓN</small>
                    <strong>03</strong>
                    <p>1 prioridad alta · 2 en seguimiento</p>
                  </div>
                  <div class="trend-card">
                    <div class="chart-head"><div><small>TENDENCIA</small><strong>Resistencia por mes</strong></div><span>ABR — SEP 2026</span></div>
                    <div class="chart-area" aria-hidden="true">
                      <i class="segment s1"></i><i class="segment s2"></i><i class="segment s3"></i><i class="segment s4"></i><i class="segment s5"></i>
                      <b class="point p1"></b><b class="point p2"></b><b class="point p3"></b><b class="point p4"></b><b class="point p5"></b><b class="point p6"></b>
                    </div>
                    <div class="chart-labels"><span>Abr</span><span>May</span><span>Jun</span><span>Jul</span><span>Ago</span><span>Sep</span></div>
                  </div>
                  <div class="table-card">
                    <div class="table-head"><strong>Combinaciones observadas</strong><span>Ver todas →</span></div>
                    <div class="table-row table-labels"><span>Microorganismo</span><span>Antibiótico</span><span>Estado</span></div>
                    <div class="table-row"><span>K. pneumoniae</span><span>Ceftriaxona</span><span class="tag-watch">Revisar</span></div>
                    <div class="table-row"><span>E. coli</span><span>Ciprofloxacino</span><span class="tag-stable">Estable</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="trace-strip" data-reveal>
          <div>
            <p class="subeyebrow">Alertas y trazabilidad</p>
            <h3>Una alerta debe explicar por qué existe.</h3>
          </div>
          <div class="trace-strip-tags">
            {traceabilityTags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </div>
    </section>


