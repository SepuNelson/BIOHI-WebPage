  <script>
    document.documentElement.classList.add('js');

    const siteHeader = document.querySelector<HTMLElement>('[data-header]');
    const menuButton = document.querySelector('[data-menu-toggle]');
    const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const mainContent = document.getElementById('contenido');
    const siteFooter = document.querySelector<HTMLElement>('.site-footer');
    let closeTimer = 0;

    const setMenu = (open: boolean) => {
      window.clearTimeout(closeTimer);
      menuButton?.setAttribute('aria-expanded', String(open));
      menuButton?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
      if (!mobileMenu) return;
      if (open) {
        mainContent?.setAttribute('inert', '');
        siteFooter?.setAttribute('inert', '');
        mobileMenu.hidden = false;
        requestAnimationFrame(() => siteHeader?.setAttribute('data-open', 'true'));
        return;
      }
      mainContent?.removeAttribute('inert');
      siteFooter?.removeAttribute('inert');
      siteHeader?.setAttribute('data-open', 'false');
      // keep it out of the accessibility tree once the overlay has faded
      closeTimer = window.setTimeout(() => { mobileMenu.hidden = true; }, 700);
    };
    const closeMenu = () => setMenu(false);

    menuButton?.addEventListener('click', () => {
      setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        if (menuButton instanceof HTMLElement) menuButton.focus();
      }
    });

    const topSentinel = document.querySelector('#inicio');
    if (topSentinel) {
      new IntersectionObserver(
        ([entry]) => siteHeader?.classList.toggle('scrolled', !entry.isIntersecting),
        { rootMargin: '-24px 0px 0px 0px', threshold: 0 },
      ).observe(topSentinel);
    }

    const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          element.style.transitionDelay = `${element.dataset.delay ?? 0}ms`;
          element.classList.add('is-visible');
          observer.unobserve(element);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -36px' });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }

    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a');
    const observedSections = [...navLinks]
      .map((link) => document.querySelector(link.hash))
      .filter((section): section is Element => Boolean(section));
    const activeObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      });
    }, { rootMargin: '-38% 0px -54%' });
    observedSections.forEach((section) => activeObserver.observe(section));

    // B11 — each word crosses the trigger line on its own, in reading order.
    // Progress is read inside a rAF loop that only runs while the block is in
    // view, so there is no unthrottled scroll listener.
    const taglineBlock = document.querySelector<HTMLElement>('[data-tagline]');
    const taglineWords = [...document.querySelectorAll<HTMLElement>('[data-tagline] .tagline-word')];
    if (taglineBlock && taglineWords.length) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        taglineWords.forEach((word) => word.classList.add('is-lit'));
      } else {
        let ticking = false;
        let lastLit = -1;

        const paint = () => {
          ticking = false;
          const rect = taglineBlock.getBoundingClientRect();
          const start = window.innerHeight * 0.88;
          const end = window.innerHeight * 0.32;
          const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end)));
          const lit = Math.round(progress * taglineWords.length);
          if (lit === lastLit) return;
          taglineWords.forEach((word, index) => word.classList.toggle('is-lit', index < lit));
          lastLit = lit;
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(paint);
        };

        const blockObserver = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
          } else {
            window.removeEventListener('scroll', onScroll);
          }
        }, { threshold: 0 });
        blockObserver.observe(taglineBlock);
      }
    }

    const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
    const formStatus = document.querySelector<HTMLElement>('#form-status');

    // Sync aria-invalid with native :user-invalid state for accessibility
    const syncAria = (el: EventTarget | null) => {
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
        if (el.matches(':user-invalid')) {
          el.setAttribute('aria-invalid', 'true');
        } else if (el.matches(':user-valid')) {
          el.setAttribute('aria-invalid', 'false');
        }
      }
    };
    contactForm?.addEventListener('blur', (e) => syncAria(e.target), true);
    contactForm?.addEventListener('input', (e) => {
      if (e.target instanceof HTMLElement && e.target.hasAttribute('aria-invalid')) {
        syncAria(e.target);
      }
    });

    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        if (formStatus) formStatus.textContent = 'Revisa los campos obligatorios antes de continuar.';
        return;
      }
      const submitButton = contactForm.querySelector<HTMLButtonElement>('[data-submit]');
      submitButton?.setAttribute('data-loading', 'true');
      if (formStatus) formStatus.textContent = 'Enviando…';
      window.setTimeout(() => {
        submitButton?.removeAttribute('data-loading');
        if (formStatus) formStatus.textContent = 'El canal de envío institucional aún no está conectado. Tus datos no fueron enviados; BIOHI lo habilitará próximamente.';
      }, 700);
    });
  </script>
